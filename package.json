{
  "name": "space-mission-design-game",
  "private": true,
  "version": "1.0.0",
  "description": "NASA Space Apps 2026 \u2014 Space Mission Design Game: a Pokemon-style pixel-art NASA HQ campus where up to 4 players co-design, launch and simulate space missions.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:server\" \"vite\"",
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode single && node scripts/make-artifact.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test:engine": "tsx scripts/engine-check.ts",
    "test:phase3": "tsx scripts/phase3-check.ts",
    "calibrate": "tsx scripts/presets-calibrate.ts"
  },
  "dependencies": {
    "@types/three": "^0.170.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
